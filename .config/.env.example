# DESTinY repository connection (see docs: Configuration)
BASE_URL=https://api.staging.evidence-repository.org
ENV=staging
ROBOT_ID=<CLIENT_ID_FOR_TALKING_TO_DESTINY_REPO>
ROBOT_SECRET=<CLIENT_SECRET_FOR_TALKING_TO_DESTINY_REPO>
KEYCLOAK_ID=<KEYCLOAK_CLIENT_ID>
KEYCLOAK_SECRET=<KEYCLOAK_CLIENT_SECRET>
# KEYCLOAK_URL=https://auth.evidence-repository.org/
# KEYCLOAK_REALM=destiny

# References database connection (defaults shown, uncomment to override).
# The `postgres` service in compose.yaml picks these up as well — keep DB_NAME
# aligned: compose creates ${DB_NAME:-meta_cache}, the code default is `references`.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=references
# DB_USER=pguser
# DB_PASSWORD=password

# Enhancement rule tuning
# MIN_ABSTRACT_LENGTH=200
# MAX_TITLE_SLOP=10
# MAX_ABSTRACT_SLOP=100
# PUBLICATION_YEAR_TOLERANCE=2

# Runner pacing
# MATCH_INTERVAL_SECONDS=30
# ENHANCE_INTERVAL_SECONDS=30
# QUEUE_INTERVAL_SECONDS=3600
