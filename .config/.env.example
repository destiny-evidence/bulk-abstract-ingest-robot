# Example environment file — copy to `.env` and fill in the values below.
#   cp .config/.env.example .config/.env.secret
#
# Check app/util/config.py for configurable variables.

# --- Docker config ---
# Points to itself (absolute path) so docker can pass this on to processes.
ENV_FILE=.config/.env.example
# If set, will use
DOCKER_PG_PATH=.data/db
# Port on docker host to expose database to
HOST_DB_PORT=5432
# Port for monitoring with evidence.dev
MONITORING_PORT=3000

# --- DESTinY repository connection ---
# Robot client ID (UUID), issued at robot registration
ROBOT_ID=11111111-1111-1111-1111-111111111111
# Secret for signing robot API calls
ROBOT_SECRET=very-secret

# Repository API endpoint
#BASE_URL=https://api.staging.evidence-repository.org

# Deployment label: local | development | staging | test (informational)
#ENV=staging

# Provenance/source string attached to submitted enhancements
#REPOSITORY_PROVENANCE=PIK Metadata Cache

# Robot name/version — derived from pyproject.toml, override only in exceptional cases
#ROBOT_NAME=bulk-abstract-ingest
#ROBOT_VERSION=0.3.0

# --- KeyCloak (SSO) client settings (REQUIRED at runtime) ---
# Used for reference lookups and enhancement requests
KEYCLOAK_ID=abstract-loader-example-client
KEYCLOAK_SECRET=very-secret
#KEYCLOAK_URL=https://auth.evidence-repository.org/
#KEYCLOAK_REALM=destiny

# --- Database ---
# The `postgres` service in compose.yaml picks these up as well — keep DB_NAME
# aligned: compose creates ${DB_NAME:-meta_cache}, the code default is `references`.
#DB_HOST=localhost
#DB_PORT=5432
#DB_NAME=references
#DB_USER=pguser
#DB_PASSWORD=password

# --- Runner pacing & batching ---
# Sleep between match-loop iterations (seconds)
#MATCH_INTERVAL_SECONDS=30

# Sleep between enhancement batches (seconds)
#ENHANCE_INTERVAL_SECONDS=30

# Sleep between checks for new files to transfer to ingest queue (seconds)
#QUEUE_INTERVAL_SECONDS=3600

# References evaluated against the repository per match-loop iteration
#REQUEST_BATCH_SIZE=10

# References requested per enhancement batch poll
#FULFIL_BATCH_SIZE=10

# Max identifiers per repository lookup request (1-100; IDs travel in the URL)
#REPOSITORY_LOOKUP_BATCH_SIZE=100

# Max concurrent repository lookup requests
#REPOSITORY_LOOKUP_CONCURRENCY=1

# --- Enhancement runner settings ---
# Abstracts shorter than this are never considered (in either direction)
#MIN_ABSTRACT_LENGTH=200

# Max normalised edit distance for titles to count as the same paper
#MAX_TITLE_SLOP=10

# Max normalised edit distance for abstracts to count as identical
#MAX_ABSTRACT_SLOP=100

# Publication years may differ by at most this many years when both are known
#PUBLICATION_YEAR_TOLERANCE=2

# --- Queue runner settings ---
# Public REST API of the academic-api tool (used for progress reporting)
#API_WRAPPER_ENDPOINT=http://localhost:8000/api

# Auth key for the academic-api tool API
#API_WRAPPER_API_KEY=very-secret

# Rows to process before submitting a checkpoint to the academic-api tool API
#API_WRAPPER_CHECKPOINT_INTERVAL=1000

# Directory hosting per-ingest file locks (must be visible to all transfer processes on a shared host)
#TRANSFER_LOCKS_PATH=.data/locks/

# --- Logging ---
# dictConfig file for logging (default silences chatty third-party loggers)
#LOG_CONFIG=.config/logging.json

# Root log level (int, e.g. 10=DEBUG, 20=INFO); usually set via --loglevel instead
#LOGLEVEL=10
