{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "default": {
            "format": "%(asctime)s [%(levelname)s] %(name)s (%(process)d): %(message)s",
            "datefmt": "%Y-%m-%d %H:%M:%S"
        }
    },
    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
            "formatter": "default",
            "stream": "ext://sys.stderr"
        }
    },
    "root": {
        "level": "INFO",
        "handlers": ["console"]
    },
    "loggers": {
        "academic_apis.task": {
            "level": "DEBUG",
            "handlers": [],
            "propagate": false
        },
        "matplotlib": {
            "level": "WARNING"
        },
        "urllib3": {
            "level": "WARNING"
        },
        "httpcore": {
            "level": "WARNING"
        },
        "httpx": {
            "level": "WARNING"
        },
        "sqlalchemy": {
            "level": "WARNING"
        },
        "sqlalchemy.engine": {
            "level": "WARNING"
        },
        "sqlalchemy.pool": {
            "level": "WARNING"
        },
        "azure": {
            "level": "WARNING"
        },
        "azure.core": {
            "level": "WARNING"
        },
        "azure.identity": {
            "level": "WARNING"
        }
    }
}